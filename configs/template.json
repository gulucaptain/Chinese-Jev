{
  "dataset": "chinese-jev",
  "dataset_params": {
    "data_root": "/path/to/your/release",
    "file_template": "{split}.cases.jsonl.gz",
    "splits": ["train", "validation", "test"]
  },
  "bundle": "/path/to/model/bundle",
  "cache_dir": "runs/cache/my-dataset",
  "work_dir": "runs/my-run",

  "head_max_len": null,
  "max_len": 4096,

  "epochs": 4,
  "batch_size": 8,
  "accumulation": 4,
  "encoder_lr": 2.5e-05,
  "head_lr": 0.0001,
  "group_size": 4,
  "sigma_start": 0.4,
  "sigma_end": 0.1,
  "precision": "bf16",
  "seed": 42,

  "overlong": "filter",
  "length_bucketed_batches": true,
  "num_workers": 4,
  "tokenize_workers": 0,
  "tokenize_chunk": 2000,

  "save_every_steps": 2000,
  "keep_last_checkpoints": 3,
  "keep_epoch_checkpoints": true,
  "calibration_max_items": 2000,
  "log_every": 50
}
